    {
      "id": "dynSc",
      "label": "DYN SC",
      "kind": "switch",
      "mapping": {
        "param": {
          "name": [
            "Dyn SC",
            "EQ to Dyn SC",
            "Dyn Sidechain"
          ]
        },
        "type": "switch"
      }
    },
    {
      "id": "eqType",
      "label": "TYPE",
      "kind": "switch",
      "mapping": {
        "param": {
          "name": [
            "EQ Type",
            "Type"
          ]
        },
        "type": "switch"
      }
    },
    {
      "id": "compAttack",
      "label": "ATTACK",
      "kind": "stepped",
      "steps": [
        "F",
        "M",
        "S"
      ],
      "default": 1,
      "mapping": {
        "param": {
          "name": [
            "Comp Attack",
            "Attack"
          ]
        },
        "type": "even"
      }
    },
    {
      "id": "knee",
      "label": "KNEE",
      "kind": "stepped",
      "steps": [
        "HRD",
        "SFT"
      ],
      "mapping": {
        "param": {
          "name": [
            "Knee",
            "Comp Knee"
          ]
        },
        "type": "even"
      }
    },
    {
      "id": "compType",
      "label": "TYPE",
      "kind": "stepped",
      "steps": [
        "NEW",
        "OLD"
      ],
      "mapping": {
        "param": {
          "name": [
            "Comp Type",
            "Type"
          ]
        },
        "type": "even"
      }
    },
    {
      "id": "gateRelease",
      "label": "R/H",
      "kind": "continuous",
      "min": 0.05,
      "max": 3,
      "scale": "log",
      "unit": "s",
      "mapping": {
        "param": {
          "name": [
            "Gate Release",
            "Gate R/H",
            "Release/Hold"
          ]
        },
        "type": "continuous",
        "curve": {
          "kind": "auto"
        }
      }
    },
    {
      "id": "gateMode",
      "label": "MODE",
      "kind": "stepped",
      "steps": [
        "EXP",
        "GTE"
      ],
      "default": 1,
      "mapping": {
        "param": {
          "name": [
            "Gate Mode",
            "Exp/Gate",
            "Expander/Gate"
          ]
        },
        "type": "even"
      }
    }
  ],
