{
  "$schema": "../schema/profile.schema.json",
  "schemaVersion": 2,
  "id": "uad.api-vision-channel-strip",
  "name": "API Vision Channel Strip",
  "author": "Stripline",
  "status": "draft",
  "notes": "Draft: parameter names are candidates and ranges are read from the plugin when it loads. Send the .params.json from the bridge's \"Write profile template\" to verify it.",
  "plugin": {
    "name": "API Vision Channel Strip",
    "aliases": [
      "UAD API Vision Channel Strip"
    ],
    "vendor": "Universal Audio",
    "scan": {
      "files": [
        "API Vision"
      ]
    }
  },
  "mappings": {
    "input.phase": {
      "param": {
        "name": [
          "Phase",
          "Polarity",
          "Phase Invert"
        ]
      },
      "type": "switch"
    },
    "input.gain": {
      "param": {
        "name": [
          "Mic Gain",
          "Mic",
          "Gain",
          "Preamp Gain"
        ]
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "input.trim": {
      "param": {
        "name": [
          "Line Gain",
          "Line",
          "Line Trim"
        ]
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "filter.lpf": {
      "param": {
        "name": [
          "Lo-Pass",
          "Low Pass",
          "LPF",
          "Lo Pass Freq"
        ]
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "filter.hpf": {
      "param": {
        "name": [
          "Hi-Pass",
          "High Pass",
          "HPF",
          "Hi Pass Freq"
        ]
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.in": {
      "param": {
        "name": [
          "EQ On",
          "EQ In",
          "EQ Enable"
        ]
      },
      "type": "switch"
    },
    "eq.hf.gain": {
      "param": {
        "name": [
          "HF Gain",
          "HF Boost/Cut",
          "HF Level"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "eq.hf.freq": {
      "param": {
        "name": [
          "HF Freq",
          "HF Frequency"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "eq.hf.bell": {
      "param": {
        "name": [
          "HF Shelf",
          "HF Peak/Shelf",
          "HF Bell"
        ]
      },
      "type": "switch",
      "invert": true
    },
    "eq.hmf.gain": {
      "param": {
        "name": [
          "HMF Gain",
          "HMF Boost/Cut",
          "HMF Level"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "eq.hmf.freq": {
      "param": {
        "name": [
          "HMF Freq",
          "HMF Frequency"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "eq.lmf.gain": {
      "param": {
        "name": [
          "LMF Gain",
          "LMF Boost/Cut",
          "LMF Level"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "eq.lmf.freq": {
      "param": {
        "name": [
          "LMF Freq",
          "LMF Frequency"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "eq.lf.gain": {
      "param": {
        "name": [
          "LF Gain",
          "LF Boost/Cut",
          "LF Level"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "eq.lf.freq": {
      "param": {
        "name": [
          "LF Freq",
          "LF Frequency"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "eq.lf.bell": {
      "param": {
        "name": [
          "LF Shelf",
          "LF Peak/Shelf",
          "LF Bell"
        ]
      },
      "type": "switch",
      "invert": true
    },
    "eq.hmf.q": {
      "available": false
    },
    "eq.lmf.q": {
      "available": false
    },
    "dyn.in": {
      "param": {
        "name": [
          "Comp On",
          "Dyn On",
          "Compressor On"
        ]
      },
      "type": "switch"
    },
    "comp.threshold": {
      "param": {
        "name": [
          "Comp Thresh",
          "Comp Threshold",
          "Threshold"
        ]
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "comp.ratio": {
      "param": {
        "name": [
          "Comp Ratio",
          "Ratio"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "comp.release": {
      "param": {
        "name": [
          "Comp Release",
          "Comp Rel",
          "Release"
        ]
      },
      "type": "stepped",
      "auto": true
    },
    "comp.attack": {
      "available": false
    },
    "comp.makeup": {
      "available": false
    },
    "comp.mix": {
      "available": false
    },
    "gate.threshold": {
      "param": {
        "name": [
          "Gate Thresh",
          "Gate Threshold"
        ]
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "gate.range": {
      "param": {
        "name": [
          "Gate Depth",
          "Depth",
          "Gate Range"
        ]
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "output.fader": {
      "param": {
        "name": [
          "Fader",
          "Output",
          "Output Level",
          "Volume"
        ]
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    }
