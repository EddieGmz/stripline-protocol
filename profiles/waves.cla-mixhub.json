        },
        {
          "rule": 214
        },
        {
          "sub": "GATE",
          "y": 220
        },
        {
          "control": "x.gateType",
          "x": 54,
          "y": 218
        },
        {
          "control": "gate.threshold",
          "x": 3,
          "y": 256,
          "cap": "#3C6E47",
          "label": "Thresh"
        },
        {
          "control": "gate.range",
          "x": 57,
          "y": 274,
          "cap": "#3C6E47",
          "label": "Range"
        },
        {
          "control": "x.gateAttack",
          "x": 3,
          "y": 318,
          "cap": "#3C6E47"
        },
        {
          "control": "x.gateHold",
          "x": 57,
          "y": 336,
          "cap": "#3C6E47"
        },
        {
          "control": "x.gateRelease",
          "x": 3,
          "y": 378,
          "cap": "#3C6E47"
        }
      ]
    }
  },
  "skin": {
    "panel": "#2A2B2E",
    "header": "#1E1F22",
    "line": "#3D3F43",
    "title": "#E8E8E8",
    "label": "#C4C6C9",
    "value": "#EEEEEE",
    "track": "#3D3F43",
    "ticks": "#8E9095",
    "arc": "#E2DAC3",
    "cap": "#BEBFC1",
    "inset": "transparent",
    "switchOff": [
      "#4A4B4E",
      "#6A6B6E",
      "#DCDCDC"
    ],
    "switchOn": [
      "#E4DCC5",
      "#E4DCC5",
      "#1B1B1B"
    ]
  }
}
