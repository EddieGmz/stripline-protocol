{
  "$schema": "../schema/profile.schema.json",
  "schemaVersion": 2,
  "id": "waves.cla-mixhub",
  "name": "CLA MixHub",
  "author": "Stripline",
  "status": "verified",
  "notes": "From CLA MixHub Mono and Stereo (VST3, WaveShell). Matched by name: mono and stereo use different ids. In stereo the plugin's Link switches (on by default) keep the right channel in step with these.",
  "plugin": {
    "name": "CLA MixHub",
    "vendor": "Waves",
    "scan": {
      "files": [
        "WaveShell"
      ],
      "shell": true,
      "timeoutSeconds": 180
    }
  },
  "mappings": {
    "input.phase": {
      "param": {
        "name": "Pre:Phase"
      },
      "type": "switch"
    },
    "input.trim": {
      "param": {
        "name": "Pre:Line"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "input.gain": {
      "param": {
        "name": "Pre:Mic"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "filter.hpf": {
      "param": {
        "name": "Pre:HP Cutoff Frq"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "filter.lpf": {
      "param": {
        "name": "Pre:LP Cutoff Frq"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.in": {
      "param": {
        "name": "Eq:On/Off"
      },
      "type": "switch"
    },
    "eq.hf.gain": {
      "param": {
        "name": "Eq:HF Gain"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.hf.freq": {
      "param": {
        "name": "Eq:HF Frequency"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.hf.bell": {
      "param": {
        "name": "Eq:HF Bell On/Off"
      },
      "type": "switch"
    },
    "eq.hmf.gain": {
      "param": {
        "name": "Eq:HMF Gain"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.hmf.freq": {
      "param": {
        "name": "Eq:HMF Frequency"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.hmf.q": {
      "param": {
        "name": "Eq:HMF Q"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.lmf.gain": {
      "param": {
        "name": "Eq:LMF Gain"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.lmf.freq": {
      "param": {
        "name": "Eq:LMF Frequency"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.lmf.q": {
      "param": {
        "name": "Eq:LMF Q"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.lf.gain": {
      "param": {
        "name": "Eq:LF Gain"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.lf.freq": {
      "param": {
        "name": "Eq:LF Frequency"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "eq.lf.bell": {
      "param": {
        "name": "Eq:LF Bell On/Off"
      },
      "type": "switch"
    },
    "dyn.in": {
      "param": {
        "name": "Dyn:On/Off"
      },
      "type": "switch"
    },
    "comp.threshold": {
      "param": {
        "name": "Dyn:Comp Threshold"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "comp.ratio": {
      "param": {
        "name": "Dyn:Ratio"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "comp.attack": {
      "available": false
    },
    "comp.release": {
      "param": {
        "name": "Dyn:Comp Release"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "comp.makeup": {
      "available": false
    },
    "comp.mix": {
      "param": {
        "name": "Dyn:Comp Mix"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "gate.threshold": {
      "param": {
        "name": "Dyn:Gate Threshold"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "gate.range": {
      "param": {
        "name": "Dyn:Range"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    },
    "output.fader": {
      "param": {
        "name": "Post:Output"
      },
      "type": "continuous",
      "curve": {
        "kind": "auto"
      }
    }
  },
  "extras": [
    {
      "id": "preIn",
      "label": "PRE",
      "kind": "switch",
      "mapping": {
        "param": {
          "name": "Pre:On/Off"
        },
        "type": "switch"
      }
    },
    {
      "id": "analog",
      "label": "ANALOG",
      "kind": "switch",
      "default": 1,
      "mapping": {
        "param": {
          "name": "Pre:Analog"
        },
        "type": "switch"
      }
    },
    {
      "id": "noise",
      "label": "NOISE",
      "kind": "switch",
      "mapping": {
        "param": {
          "name": "Pre:Noise"
        },
        "type": "switch"
      }
    },
    {
      "id": "pad",
      "label": "-20dB",
      "kind": "switch",
      "mapping": {
        "param": {
          "name": "Pre:-20dB"
        },
        "type": "switch"
      }
    },
    {
      "id": "hpfOn",
      "label": "IN",
      "kind": "switch",
      "mapping": {
        "param": {
          "name": "Pre:HP On/Off"
        },
        "type": "switch"
      }
    },
    {
      "id": "lpfOn",
      "label": "IN",
      "kind": "switch",
      "mapping": {
        "param": {
          "name": "Pre:LP On/Off"
        },
        "type": "switch"
      }
    },
    {
      "id": "compType",
      "label": "TYPE",
      "kind": "stepped",
      "steps": [
        "SSL",
        "BLUEY"
      ],
      "mapping": {
        "param": {
          "name": "Dyn:Comp Type"
        },
        "type": "even"
      }
    },
    {
      "id": "fatk",
      "label": "F.ATK",
      "kind": "switch",
      "default": 1,
      "mapping": {
        "param": {
          "name": "Dyn:Fast Attack"
        },
        "type": "switch"
      }
    },
    {
      "id": "gateType",
      "label": "TYPE",
      "kind": "stepped",
      "steps": [
        "GATE",
        "EXP",
        "DUCK"
      ],
      "mapping": {
        "param": {
          "name": "Dyn:Gate Type"
        },
        "type": "even"
      }
    },
    {
      "id": "gateAttack",
      "label": "Attack",
      "kind": "continuous",
      "min": 0.1,
      "max": 1000,
      "scale": "log",
      "unit": "ms",
      "default": 5.1,
      "mapping": {
        "param": {
          "name": "Dyn:Gate Attack"
        },
        "type": "continuous",
        "curve": {
          "kind": "auto"
        }
      }
    },
    {
      "id": "gateHold",
      "label": "Hold",
      "kind": "continuous",
      "min": 0,
      "max": 1000,
      "scale": "linear",
      "unit": "ms",
      "default": 0,
      "mapping": {
        "param": {
          "name": "Dyn:Hold"
        },
        "type": "continuous",
        "curve": {
          "kind": "auto"
        }
      }
    },
    {
      "id": "gateRelease",
      "label": "Release",
      "kind": "continuous",
      "min": 0.1,
      "max": 4,
      "scale": "log",
      "unit": "s",
      "default": 0.1,
      "mapping": {
        "param": {
          "name": "Dyn:Gate Release"
        },
        "type": "continuous",
        "curve": {
          "kind": "auto"
        }
      }
    }
  ],
  "layout": {
    "io": {
      "title": "INPUT · FILTERS",
      "head": [
        {
          "control": "input.phase",
          "label": "Ø",
          "on": "#B0302A"
        },
        {
          "control": "x.preIn",
          "on": "#B0302A"
        }
      ],
      "items": [
        {
          "control": "input.trim",
          "x": 3,
          "y": 0,
          "cap": "#BEBFC1",
          "label": "Line"
        },
        {
          "control": "input.gain",
          "x": 52,
          "y": 10,
          "size": "lg",
          "cap": "#A9302C",
          "label": "Mic"
        },
        {
          "control": "x.analog",
          "x": 2,
          "y": 70
        },
        {
          "control": "x.noise",
          "x": 56,
          "y": 88
        },
        {
          "control": "x.pad",
          "x": 2,
          "y": 98
        },
        {
          "rule": 128
        },
        {
          "sub": "FILTERS",
          "y": 134
        },
        {
          "control": "filter.hpf",
          "x": 3,
          "y": 152,
          "cap": "#BEBFC1",
          "label": "HPF"
        },
        {
          "control": "filter.lpf",
          "x": 57,
          "y": 170,
          "cap": "#BEBFC1",
          "label": "LPF"
        },
        {
          "control": "x.hpfOn",
          "x": 10,
          "y": 214
        },
        {
          "control": "x.lpfOn",
          "x": 64,
          "y": 232
        }
      ]
    },
    "eq": {
      "title": "EQ",
      "head": [
        {
          "control": "eq.in",
          "label": "IN"
        }
      ],
      "items": [
        {
          "control": "eq.hf.gain",
          "x": 0,
          "y": 0,
          "size": "lg",
          "cap": "#A9302C"
        },
        {
          "band": "HF",
          "x": 58,
          "y": 4
        },
        {
          "control": "eq.hf.freq",
          "x": 56,
          "y": 28,
          "cap": "#A9302C",
          "label": "kHz"
        },
        {
          "control": "eq.hf.bell",
          "x": 8,
          "y": 70,
          "label": "BELL"
        },
        {
          "rule": 92
        },
        {
          "control": "eq.hmf.gain",
          "x": 0,
          "y": 96,
          "size": "lg",
          "cap": "#3C6E47"
        },
        {
          "band": "HMF",
          "x": 58,
          "y": 100
        },
        {
          "control": "eq.hmf.freq",
          "x": 56,
          "y": 124,
          "cap": "#3C6E47",
          "label": "kHz"
        },
        {
          "control": "eq.hmf.q",
          "x": 3,
          "y": 162,
          "cap": "#3C6E47"
        },
        {
          "rule": 222
        },
        {
          "control": "eq.lmf.gain",
          "x": 0,
          "y": 226,
          "size": "lg",
          "cap": "#355E9A"
        },
        {
          "band": "LMF",
          "x": 58,
          "y": 230
        },
        {
          "control": "eq.lmf.freq",
          "x": 56,
          "y": 254,
          "cap": "#355E9A",
          "label": "kHz"
        },
        {
          "control": "eq.lmf.q",
          "x": 3,
          "y": 292,
          "cap": "#355E9A"
        },
        {
          "rule": 352
        },
        {
          "control": "eq.lf.gain",
          "x": 0,
          "y": 356,
          "size": "lg",
          "cap": "#232323"
        },
        {
          "band": "LF",
          "x": 58,
          "y": 360
        },
        {
          "control": "eq.lf.freq",
          "x": 56,
          "y": 384,
          "cap": "#232323",
          "label": "kHz"
        },
        {
          "control": "eq.lf.bell",
          "x": 8,
          "y": 426,
          "label": "BELL"
        }
      ]
    },
    "dyn": {
      "title": "DYN",
      "head": [
        {
          "control": "dyn.in",
          "label": "IN"
        },
        {
          "control": "x.compType"
        }
      ],
      "items": [
        {
          "control": "comp.threshold",
          "x": 0,
          "y": 0,
          "size": "lg",
          "cap": "#BEBFC1",
          "label": "Thresh"
        },
        {
          "control": "comp.ratio",
          "x": 57,
          "y": 22,
          "cap": "#BEBFC1"
        },
        {
          "control": "comp.release",
          "x": 3,
          "y": 74,
          "cap": "#BEBFC1"
        },
        {
          "control": "comp.mix",
          "x": 57,
          "y": 92,
          "cap": "#6A4D9C",
          "label": "Mix"
        },
        {
          "control": "x.fatk",
          "x": 6,
          "y": 140,
          "lit": "off"
        },
        {
          "rule": 170
        },
        {
          "sub": "GATE",
          "y": 176
        },
        {
          "control": "x.gateType",
          "x": 54,
          "y": 172
        },
        {
          "control": "gate.threshold",
          "x": 3,
          "y": 206,
          "cap": "#3C6E47",
          "label": "Thresh"
        },
        {
          "control": "gate.range",
          "x": 57,
          "y": 224,
          "cap": "#3C6E47",
          "label": "Range"
        },
        {
          "control": "x.gateAttack",
          "x": 3,
          "y": 268,
          "cap": "#3C6E47"
        },
        {
          "control": "x.gateHold",
          "x": 57,
          "y": 286,
          "cap": "#3C6E47"
        },
        {
          "control": "x.gateRelease",
          "x": 3,
          "y": 330,
          "cap": "#3C6E47"
        }
      ]
    }
  },
  "skin": {
    "panel": "#2A2B2E",
    "header": "#1E1F22",
    "line": "#3D3F43",
    "title": "#E8E8E8",
    "label": "#C4C6C9",
    "value": "#EEEEEE",
    "track": "#3D3F43",
    "ticks": "#8E9095",
    "arc": "#E2DAC3",
    "cap": "#BEBFC1",
    "inset": "transparent",
    "switchOff": [
      "#4A4B4E",
      "#6A6B6E",
      "#DCDCDC"
    ],
    "switchOn": [
      "#E4DCC5",
      "#E4DCC5",
      "#1B1B1B"
    ]
  }
}
