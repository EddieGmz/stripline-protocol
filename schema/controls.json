{
  "$comment": "Canonical list of Stripline generic controls. IDs are stable forever: never rename or reuse one. Values travel in real units (dB, Hz, ms, s, %, ratio). 'scale' says how a 0..1 knob/fader position maps to the value: linear, log (geometric), or fader (position = ((v-min)/(max-min))^2).",
  "protocolVersion": 1,
  "controls": [
    { "id": "input.gain",     "section": "input",  "group": "Input",         "label": "Gain",      "kind": "continuous", "scale": "linear", "min": -20,  "max": 20,    "default": 0,     "step": 0.5,  "unit": "dB" },
    { "id": "input.trim",     "section": "input",  "group": "Input",         "label": "Trim",      "kind": "continuous", "scale": "linear", "min": -20,  "max": 20,    "default": 0,     "step": 0.5,  "unit": "dB" },
    { "id": "input.phase",    "section": "input",  "group": "Input",         "label": "Polarity",  "kind": "switch",     "scale": "linear", "min": 0,    "max": 1,     "default": 0,     "step": 1,    "unit": "" },

    { "id": "filter.hpf",     "section": "filter", "group": "Filter",        "label": "HPF",       "kind": "continuous", "scale": "log",    "min": 20,   "max": 500,   "default": 20,    "step": 1,    "unit": "Hz" },
    { "id": "filter.lpf",     "section": "filter", "group": "Filter",        "label": "LPF",       "kind": "continuous", "scale": "log",    "min": 3000, "max": 20000, "default": 20000, "step": 10,   "unit": "Hz" },

    { "id": "eq.in",          "section": "eq",     "group": "EQ",            "label": "EQ In",     "kind": "switch",     "scale": "linear", "min": 0,    "max": 1,     "default": 1,     "step": 1,    "unit": "" },
    { "id": "eq.lf.gain",     "section": "eq",     "group": "EQ · Low",      "label": "Gain",      "kind": "continuous", "scale": "linear", "min": -15,  "max": 15,    "default": 0,     "step": 0.5,  "unit": "dB" },
    { "id": "eq.lf.freq",     "section": "eq",     "group": "EQ · Low",      "label": "Freq",      "kind": "continuous", "scale": "log",    "min": 30,   "max": 450,   "default": 100,   "step": 1,    "unit": "Hz" },
    { "id": "eq.lf.bell",     "section": "eq",     "group": "EQ · Low",      "label": "Bell",      "kind": "switch",     "scale": "linear", "min": 0,    "max": 1,     "default": 0,     "step": 1,    "unit": "" },
    { "id": "eq.lmf.gain",    "section": "eq",     "group": "EQ · Low mid",  "label": "Gain",      "kind": "continuous", "scale": "linear", "min": -15,  "max": 15,    "default": 0,     "step": 0.5,  "unit": "dB" },
    { "id": "eq.lmf.freq",    "section": "eq",     "group": "EQ · Low mid",  "label": "Freq",      "kind": "continuous", "scale": "log",    "min": 200,  "max": 2500,  "default": 400,   "step": 1,    "unit": "Hz" },
    { "id": "eq.lmf.q",       "section": "eq",     "group": "EQ · Low mid",  "label": "Q",         "kind": "continuous", "scale": "log",    "min": 0.3,  "max": 5,     "default": 1,     "step": 0.01, "unit": "" },
    { "id": "eq.hmf.gain",    "section": "eq",     "group": "EQ · High mid", "label": "Gain",      "kind": "continuous", "scale": "linear", "min": -15,  "max": 15,    "default": 0,     "step": 0.5,  "unit": "dB" },
    { "id": "eq.hmf.freq",    "section": "eq",     "group": "EQ · High mid", "label": "Freq",      "kind": "continuous", "scale": "log",    "min": 600,  "max": 7000,  "default": 2500,  "step": 1,    "unit": "Hz" },
    { "id": "eq.hmf.q",       "section": "eq",     "group": "EQ · High mid", "label": "Q",         "kind": "continuous", "scale": "log",    "min": 0.3,  "max": 5,     "default": 1,     "step": 0.01, "unit": "" },
    { "id": "eq.hf.gain",     "section": "eq",     "group": "EQ · High",     "label": "Gain",      "kind": "continuous", "scale": "linear", "min": -15,  "max": 15,    "default": 0,     "step": 0.5,  "unit": "dB" },
    { "id": "eq.hf.freq",     "section": "eq",     "group": "EQ · High",     "label": "Freq",      "kind": "continuous", "scale": "log",    "min": 1500, "max": 16000, "default": 8000,  "step": 10,   "unit": "Hz" },
    { "id": "eq.hf.bell",     "section": "eq",     "group": "EQ · High",     "label": "Bell",      "kind": "switch",     "scale": "linear", "min": 0,    "max": 1,     "default": 0,     "step": 1,    "unit": "" },

    { "id": "dyn.in",         "section": "dyn",    "group": "Dynamics",      "label": "Dyn In",    "kind": "switch",     "scale": "linear", "min": 0,    "max": 1,     "default": 1,     "step": 1,    "unit": "" },
    { "id": "comp.threshold", "section": "dyn",    "group": "Dynamics",      "label": "Threshold", "kind": "continuous", "scale": "linear", "min": -40,  "max": 0,     "default": -10,   "step": 0.5,  "unit": "dB" },
    { "id": "comp.ratio",     "section": "dyn",    "group": "Dynamics",      "label": "Ratio",     "kind": "continuous", "scale": "log",    "min": 1,    "max": 10,    "default": 3,     "step": 0.1,  "unit": ":1" },
    { "id": "comp.attack",    "section": "dyn",    "group": "Dynamics",      "label": "Attack",    "kind": "continuous", "scale": "log",    "min": 0.1,  "max": 30,    "default": 3,     "step": 0.1,  "unit": "ms" },
    { "id": "comp.release",   "section": "dyn",    "group": "Dynamics",      "label": "Release",   "kind": "continuous", "scale": "log",    "min": 0.05, "max": 4,     "default": 0.3,   "step": 0.01, "unit": "s" },
    { "id": "comp.makeup",    "section": "dyn",    "group": "Dynamics",      "label": "Gain",      "kind": "continuous", "scale": "linear", "min": 0,    "max": 20,    "default": 0,     "step": 0.5,  "unit": "dB" },
    { "id": "comp.mix",       "section": "dyn",    "group": "Dynamics",      "label": "Mix",       "kind": "continuous", "scale": "linear", "min": 0,    "max": 100,   "default": 100,   "step": 1,    "unit": "%" },
    { "id": "gate.threshold", "section": "dyn",    "group": "Gate",          "label": "Threshold", "kind": "continuous", "scale": "linear", "min": -80,  "max": 0,     "default": -80,   "step": 1,    "unit": "dB" },
    { "id": "gate.range",     "section": "dyn",    "group": "Gate",          "label": "Range",     "kind": "continuous", "scale": "linear", "min": 0,    "max": 80,    "default": 40,    "step": 1,    "unit": "dB" },

    { "id": "output.fader",   "section": "output", "group": "Output",        "label": "Fader",     "kind": "continuous", "scale": "fader",  "min": -60,  "max": 12,    "default": 0,     "step": 0.5,  "unit": "dB" }
  ]
}
